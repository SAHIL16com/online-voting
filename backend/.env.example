# Server Configuration
PORT=5005
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/voting_db

# JWT Configuration (Choose a strong, random key in production)
JWT_SECRET=your_super_secure_random_jwt_secret_key_here
JWT_EXPIRE=30d

# Cloudinary Credentials (For candidate photos & banners)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
